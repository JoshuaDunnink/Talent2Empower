---
const currentPath = Astro.url.pathname.replace(/\/$/, "");

const navItems = [
  { href: '/over-ons', label: 'Over Ons' },
  { href: '/voor-ouders', label: 'Ouders' },
  { href: '/voor-scholen', label: 'Scholen' },
  { href: '/voor-sportverenigingen', label: 'Sportverenigingen' },
];
---

<header class="fixed top-0 left-0 right-0 z-50 bg-surface/90 backdrop-blur-md transition-all duration-300 border-b border-outline-variant/10">
  <div class="flex justify-between items-center w-full px-margin-mobile md:px-margin-desktop py-4 max-w-container-max mx-auto">
    <a class="font-headline-md text-2xl font-bold text-primary" href="/">Talent2Empower</a>
    <nav class="hidden md:flex items-center gap-8">
      {navItems.map((item) => (
        <a 
          href={item.href || "/"} 
          class:list={[
            "font-body text-base transition-all",
            currentPath === item.href
              ? "text-primary font-bold border-b-2 border-primary pb-1" 
              : "text-on-surface-variant hover:text-primary"
          ]}
        >
          {item.label}
        </a>
      ))}
    </nav>
    <div class="flex items-center gap-4">
      <a href="/contact" class="bg-secondary text-on-secondary px-6 py-2.5 rounded-lg font-body font-bold hover:bg-secondary-container transition-all active:opacity-80">
        Contact
      </a>
      <button class="md:hidden text-primary" id="mobile-menu-button">
        <span class="material-symbols-outlined text-[32px]">menu</span>
      </button>
    </div>
  </div>
</header>

<script>
  const header = document.querySelector('header');
  window.addEventListener('scroll', () => {
    if (window.scrollY > 20) {
      header?.classList.add('shadow-lg', 'py-3');
      header?.classList.remove('py-4');
    } else {
      header?.classList.remove('shadow-lg', 'py-3');
      header?.classList.add('py-4');
    }
  });
</script>

<style>
  @media (max-width: 768px) {
    .nav-menu {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      flex-direction: column;
      background-color: var(--color-surface-container-lowest);
      border-bottom: 1px solid var(--color-outline-variant);
      padding: var(--space-4);
      gap: var(--space-4);
      display: none;
    }
    
    .nav-menu.active {
      display: flex;
    }
  }
</style>


<script>
  const menuToggle = document.getElementById('menu-toggle');
  const navMenu = document.getElementById('nav-menu');
  
  menuToggle?.addEventListener('click', () => {
    navMenu?.classList.toggle('active');
  });
</script>
