---
const currentYear = new Date().getFullYear();
---

<footer class="bg-surface-container-high border-t border-outline-variant py-16">
  <div class="max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-gutter mb-12">
      <div class="col-span-1 md:col-span-1">
        <div class="font-headline-md text-headline-md font-bold text-primary mb-6">Talent2Empower</div>
        <p class="font-body-md text-body-md text-on-surface-variant">Specialistische begeleiding voor hoogbegaafde kinderen en strategische groei voor scholen en sportverenigingen.</p>
      </div>
      <div>
        <h4 class="font-label-md text-label-md font-bold uppercase mb-6 text-on-surface">Navigatie</h4>
        <ul class="space-y-4">
          <li><a class="font-body-md text-body-md text-on-surface-variant hover:text-primary transition-all underline decoration-transparent hover:decoration-primary" href="/voor-ouders">Ouders</a></li>
          <li><a class="font-body-md text-body-md text-on-surface-variant hover:text-primary transition-all underline decoration-transparent hover:decoration-primary" href="/voor-scholen">Scholen</a></li>
          <li><a class="font-body-md text-body-md text-on-surface-variant hover:text-primary transition-all underline decoration-transparent hover:decoration-primary" href="/voor-sportverenigingen">Sportverenigingen</a></li>
          <li><a class="font-body-md text-body-md text-on-surface-variant hover:text-primary transition-all underline decoration-transparent hover:decoration-primary" href="/over-ons">Over Ons</a></li>
        </ul>
      </div>
      <div>
        <h4 class="font-label-md text-label-md font-bold uppercase mb-6 text-on-surface">Contact</h4>
        <ul class="space-y-4">
          <li class="flex items-center gap-3 font-body-md text-body-md text-on-surface-variant">
            <span class="material-symbols-outlined text-[20px]">mail</span>
            info@talent2empower.nl
          </li>
          <li class="flex items-center gap-3 font-body-md text-body-md text-on-surface-variant">
            <span class="material-symbols-outlined text-[20px]">location_on</span>
            Nederland, Diverse locaties
          </li>
        </ul>
      </div>
      <div>
        <h4 class="font-label-md text-label-md font-bold uppercase mb-6 text-on-surface">Social</h4>
        <div class="flex gap-4">
          <a class="w-10 h-10 rounded-full bg-white border border-outline-variant flex items-center justify-center text-primary hover:bg-primary hover:text-white transition-all" href="#">
            <span class="material-symbols-outlined">share</span>
          </a>
          <a class="w-10 h-10 rounded-full bg-white border border-outline-variant flex items-center justify-center text-primary hover:bg-primary hover:text-white transition-all" href="#">
            <span class="material-symbols-outlined">person_add</span>
          </a>
        </div>
      </div>
    </div>
    <div class="pt-8 border-t border-outline-variant flex flex-col md:flex-row justify-between items-center gap-4">
      <p class="font-body-md text-body-md text-on-surface-variant opacity-60">© {currentYear} Talent2Empower. Alle rechten voorbehouden.</p>
      <div class="flex gap-6">
        <a class="font-body-md text-sm text-on-surface-variant hover:text-primary" href="#">Privacy Policy</a>
        <a class="font-body-md text-sm text-on-surface-variant hover:text-primary" href="#">Algemene Voorwaarden</a>
      </div>
    </div>
  </div>
</footer>
