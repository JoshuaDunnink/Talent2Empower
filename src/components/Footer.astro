---
const currentYear = new Date().getFullYear();
---

<footer class="bg-surface-container-high border-t border-outline-variant py-16">
  <div class="max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-gutter mb-12">
      <div class="col-span-1 md:col-span-1">
        <div class="font-headline-md text-headline-md font-bold text-primary mb-6">
          Talent2Empower
        </div>
        <p class="font-body-md text-body-md text-on-surface-variant">
          Specialistische begeleiding voor hoogbegaafde kinderen en strategische groei voor scholen
          en sportverenigingen.
        </p>
      </div>
      <div>
        <h4 class="font-label-md text-label-md font-bold uppercase mb-6 text-on-surface">
          Navigatie
        </h4>
        <ul class="space-y-4">
          <li>
            <a
              class="font-body-md text-body-md text-on-surface-variant hover:text-primary transition-all underline decoration-transparent hover:decoration-primary"
              href="/voor-ouders">Ouders</a
            >
          </li>
          <li>
            <a
              class="font-body-md text-body-md text-on-surface-variant hover:text-primary transition-all underline decoration-transparent hover:decoration-primary"
              href="/voor-scholen">Scholen</a
            >
          </li>
          <li>
            <a
              class="font-body-md text-body-md text-on-surface-variant hover:text-primary transition-all underline decoration-transparent hover:decoration-primary"
              href="/voor-sportverenigingen">Sportverenigingen</a
            >
          </li>
          <li>
            <a
              class="font-body-md text-body-md text-on-surface-variant hover:text-primary transition-all underline decoration-transparent hover:decoration-primary"
              href="/watersport">Watersport</a
            >
          </li>
          <li>
            <a
              class="font-body-md text-body-md text-on-surface-variant hover:text-primary transition-all underline decoration-transparent hover:decoration-primary"
              href="/turn-fotografie">Turn Fotografie</a
            >
          </li>
          <li>
            <a
              class="font-body-md text-body-md text-on-surface-variant hover:text-primary transition-all underline decoration-transparent hover:decoration-primary"
              href="/cofun">CoFun</a
            >
          </li>
          <li>
            <a
              class="font-body-md text-body-md text-on-surface-variant hover:text-primary transition-all underline decoration-transparent hover:decoration-primary"
              href="/over-ons">Over Ons</a
            >
          </li>
          <li>
            <a
              class="font-body-md text-body-md text-on-surface-variant hover:text-primary transition-all underline decoration-transparent hover:decoration-primary"
              href="https://www.cofun.nl"
              target="_blank"
              rel="noopener">www.cofun.nl ↗</a
            >
          </li>
        </ul>
      </div>
      <div>
        <h4 class="font-label-md text-label-md font-bold uppercase mb-6 text-on-surface">
          Contact
        </h4>
        <ul class="space-y-4">
          <li class="flex items-center gap-3 font-body-md text-body-md text-on-surface-variant">
            <span class="material-symbols-outlined text-[20px]">mail</span>
            <a href="mailto:info@talent2empower.nl" class="hover:text-primary transition-colors"
              >info@talent2empower.nl</a
            >
          </li>
          <li class="flex items-start gap-3 font-body-md text-body-md text-on-surface-variant">
            <span class="material-symbols-outlined text-[20px]">location_on</span>
            <span>Muiderweg 57<br />Zeewolde, Nederland</span>
          </li>
        </ul>
      </div>
      <div>
        <h4 class="font-label-md text-label-md font-bold uppercase mb-6 text-on-surface">Social</h4>
        <div class="flex gap-4">
          <a
            class="w-10 h-10 rounded-full bg-surface-container-lowest border border-outline-variant flex items-center justify-center text-primary hover:bg-primary hover:text-on-primary transition-all"
            href="https://www.instagram.com/jent5678"
            target="_blank"
            rel="noopener"
            aria-label="Instagram"
          >
            <svg viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5" aria-hidden="true">
              <path
                d="M12 2.2c3.2 0 3.6 0 4.9.1 1.2.1 1.8.2 2.2.4.6.2 1 .5 1.4.9.4.4.7.8.9 1.4.2.4.3 1 .4 2.2.1 1.3.1 1.7.1 4.9s0 3.6-.1 4.9c-.1 1.2-.2 1.8-.4 2.2-.2.6-.5 1-.9 1.4-.4.4-.8.7-1.4.9-.4.2-1 .3-2.2.4-1.3.1-1.7.1-4.9.1s-3.6 0-4.9-.1c-1.2-.1-1.8-.2-2.2-.4-.6-.2-1-.5-1.4-.9-.4-.4-.7-.8-.9-1.4-.2-.4-.3-1-.4-2.2-.1-1.3-.1-1.7-.1-4.9s0-3.6.1-4.9c.1-1.2.2-1.8.4-2.2.2-.6.5-1 .9-1.4.4-.4.8-.7 1.4-.9.4-.2 1-.3 2.2-.4C8.4 2.2 8.8 2.2 12 2.2zm0 1.8c-3.1 0-3.5 0-4.7.1-1.1.1-1.7.2-2.1.4-.5.2-.9.4-1.2.8-.4.3-.6.7-.8 1.2-.2.4-.3 1-.4 2.1-.1 1.2-.1 1.6-.1 4.7s0 3.5.1 4.7c.1 1.1.2 1.7.4 2.1.2.5.4.9.8 1.2.3.4.7.6 1.2.8.4.2 1 .3 2.1.4 1.2.1 1.6.1 4.7.1s3.5 0 4.7-.1c1.1-.1 1.7-.2 2.1-.4.5-.2.9-.4 1.2-.8.4-.3.6-.7.8-1.2.2-.4.3-1 .4-2.1.1-1.2.1-1.6.1-4.7s0-3.5-.1-4.7c-.1-1.1-.2-1.7-.4-2.1-.2-.5-.4-.9-.8-1.2-.3-.4-.7-.6-1.2-.8-.4-.2-1-.3-2.1-.4-1.2-.1-1.6-.1-4.7-.1zm0 3.1a4.9 4.9 0 110 9.8 4.9 4.9 0 010-9.8zm0 8.1a3.2 3.2 0 100-6.4 3.2 3.2 0 000 6.4zm6.2-8.3a1.1 1.1 0 11-2.3 0 1.1 1.1 0 012.3 0z"
              ></path>
            </svg>
          </a>
        </div>
      </div>
    </div>
    <div
      class="pt-8 border-t border-outline-variant flex flex-col md:flex-row justify-between items-center gap-4"
    >
      <p class="font-body-md text-body-md text-on-surface-variant opacity-60">
        © {currentYear} Talent2Empower. Alle rechten voorbehouden.
      </p>
      <div class="flex gap-6">
        <a class="font-body-md text-sm text-on-surface-variant hover:text-primary" href="#"
          >Privacy Policy</a
        >
        <a class="font-body-md text-sm text-on-surface-variant hover:text-primary" href="#"
          >Algemene Voorwaarden</a
        >
      </div>
    </div>
  </div>
</footer>
