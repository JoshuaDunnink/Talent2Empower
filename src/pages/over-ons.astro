---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Over Ons - Talent2Empower" description="Leer meer over de missie en visie van Talent2Empower. Wij transformeren uitdagingen in kansen voor talent.">
  <section class="relative py-24 overflow-hidden">
    <div class="max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop">
      <div class="grid md:grid-cols-2 gap-16 items-center">
        <div class="order-2 md:order-1">
          <div class="relative">
            <div class="absolute -inset-4 bg-primary/10 rounded-3xl blur-2xl -z-10"></div>
            <img alt="Team of Talent2Empower" class="rounded-3xl shadow-2xl w-full object-cover" src="https://lh3.googleusercontent.com/aida/AP1WRLuCvameIb0e-ZQRjWBikXl9p3Ero1kyjo2dIhc47hZs-U96kfPrgoYN-FTamvecrPqZBGdSboobeTGisFO6MSIXb-majdwG9mASloXYvMshj3GO0PdAtbI234e_fc7rPOHnYPg-aiLZ5LfhWKXu2guLNk5aLPeSS07Ra3NNS1who-IOPL5UF92dYM6DNCzxzmLXWdFeGJog3MycyegTjhCc2Lwkrv-4c9cSsqrXjcYxhzLlbPnUn_ZIwg"/>
          </div>
        </div>
        <div class="order-1 md:order-2 space-y-8">
          <div class="inline-block px-4 py-1 bg-primary-container text-on-primary-container rounded-lg font-label-sm text-xs font-bold uppercase tracking-wider">Onze Visie</div>
          <h1 class="font-headline-md text-4xl md:text-6xl text-on-background font-bold leading-tight">Over Talent2Empower</h1>
          <p class="font-body text-xl text-on-surface-variant leading-relaxed">
            Talent2Empower is geboren uit de overtuiging dat talent altijd gezien moet worden. Wij transformeren uitdagingen in kansen voor zowel het individu als de organisatie.
          </p>
          
          <div class="grid sm:grid-cols-2 gap-6 pt-4">
            <div class="p-8 bg-surface-container-low rounded-2xl border border-outline-variant/30">
              <div class="w-12 h-12 bg-primary text-white rounded-xl flex items-center justify-center mb-4">
                <span class="material-symbols-outlined">target</span>
              </div>
              <h4 class="font-headline-md text-2xl text-primary mb-3 font-bold">Missie</h4>
              <p class="font-body text-base text-on-surface-variant">Het fundament versterken voor duurzame groei en blijvende rust voor talentvolle individuen.</p>
            </div>
            <div class="p-8 bg-surface-container-low rounded-2xl border border-outline-variant/30">
              <div class="w-12 h-12 bg-secondary text-white rounded-xl flex items-center justify-center mb-4">
                <span class="material-symbols-outlined">visibility</span>
              </div>
              <h4 class="font-headline-md text-2xl text-secondary mb-3 font-bold">Visie</h4>
              <p class="font-body text-base text-on-surface-variant">Een landschap waarin elke school en sportclub de tools heeft om talent echt te empoweren.</p>
            </div>
          </div>
          
          <div class="p-6 bg-primary/5 rounded-2xl border-l-4 border-primary italic">
            <p class="font-body text-lg text-on-surface-variant">
              "Wanneer talent gezien wordt, ontstaat er niet alleen groei, maar ook de mentale ruimte om te excelleren."
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Core Values -->
  <section class="py-24 bg-on-background text-white">
    <div class="max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop text-center">
      <h2 class="font-headline-md text-4xl md:text-5xl mb-16 font-bold">Onze Kernwaarden</h2>
      <div class="grid md:grid-cols-3 gap-12">
        <div class="space-y-4">
          <span class="material-symbols-outlined text-primary-fixed text-5xl">psychology</span>
          <h3 class="font-headline-md text-2xl font-bold">Expertise</h3>
          <p class="text-surface-variant">Gefundeerd op wetenschappelijk onderzoek en jarenlange praktijkervaring.</p>
        </div>
        <div class="space-y-4">
          <span class="material-symbols-outlined text-primary-fixed text-5xl">handshake</span>
          <h3 class="font-headline-md text-2xl font-bold">Integriteit</h3>
          <p class="text-surface-variant">Een veilige haven voor kinderen, ouders en professionals.</p>
        </div>
        <div class="space-y-4">
          <span class="material-symbols-outlined text-primary-fixed text-5xl">trending_up</span>
          <h3 class="font-headline-md text-2xl font-bold">Impact</h3>
          <p class="text-surface-variant">Wij streven naar concrete, meetbare resultaten in elke situatie.</p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
