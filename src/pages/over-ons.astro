---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import teamImg from '../assets/images/section-over-ons.jpg';
---

<BaseLayout
  title="Over Ons - Talent2Empower"
  description="Leer meer over de missie en visie van Talent2Empower. Wij transformeren uitdagingen in kansen voor talent."
>
  <!-- Hero / Vision -->
  <section class="relative pt-24 pb-16 md:py-24 overflow-hidden">
    <div class="max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-12 md:gap-16 items-center">
        <div class="order-2 md:order-1 reveal">
          <div class="relative">
            <div class="absolute -inset-4 bg-primary/10 rounded-3xl blur-2xl -z-10"></div>
            <Image
              src={teamImg}
              alt="Team of Talent2Empower"
              class="rounded-3xl shadow-2xl w-full object-cover"
            />
          </div>
        </div>
        <div class="order-1 md:order-2 space-y-8 reveal">
          <div
            class="inline-block px-4 py-1 glass-panel text-secondary-fixed-dim rounded-lg font-label-sm text-label-sm uppercase tracking-widest"
          >
            Onze Visie
          </div>
          <h1
            class="font-display-lg text-display-lg-mobile md:text-display-lg text-on-surface leading-tight"
          >
            Over <span class="text-primary italic">Talent2Empower</span>
          </h1>
          <p class="font-body-lg text-body-lg text-on-surface-variant leading-relaxed">
            Talent2Empower is geboren uit de overtuiging dat talent altijd gezien moet worden. Wij
            transformeren uitdagingen in kansen voor zowel het individu als de organisatie.
          </p>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 pt-4">
            <div class="glass-panel kinetic-hover p-8 rounded-2xl border border-outline-variant/40">
              <div
                class="w-12 h-12 bg-primary text-on-primary rounded-xl flex items-center justify-center mb-4"
              >
                <span class="material-symbols-outlined">target</span>
              </div>
              <h4 class="font-headline-md text-headline-md text-primary mb-3">Missie</h4>
              <p class="font-body-md text-body-md text-on-surface-variant">
                Het fundament versterken voor duurzame groei en blijvende rust voor talentvolle
                individuen.
              </p>
            </div>
            <div class="glass-panel kinetic-hover p-8 rounded-2xl border border-outline-variant/40">
              <div
                class="w-12 h-12 bg-primary text-on-primary rounded-xl flex items-center justify-center mb-4"
              >
                <span class="material-symbols-outlined">visibility</span>
              </div>
              <h4 class="font-headline-md text-headline-md text-secondary-fixed-dim mb-3">Visie</h4>
              <p class="font-body-md text-body-md text-on-surface-variant">
                Een landschap waarin elke school en sportclub de tools heeft om talent echt te
                empoweren.
              </p>
            </div>
          </div>

          <div class="glass-panel p-6 rounded-2xl border-l-4 border-primary italic">
            <p class="font-body-lg text-body-lg text-on-surface-variant">
              "Wanneer talent gezien wordt, ontstaat er niet alleen groei, maar ook de mentale
              ruimte om te excelleren."
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Core Values -->
  <section class="py-16 md:py-24 bg-surface-container-lowest">
    <div class="max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop text-center">
      <h2
        class="font-headline-xl text-headline-lg-mobile md:text-headline-xl text-on-surface mb-16 reveal"
      >
        Onze Kernwaarden
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-12">
        <div class="glass-panel kinetic-hover p-8 rounded-2xl space-y-4 reveal">
          <span class="material-symbols-outlined text-primary text-5xl">psychology</span>
          <h3 class="font-headline-md text-headline-md text-on-surface">Expertise</h3>
          <p class="font-body-md text-body-md text-on-surface-variant">
            Gefundeerd op wetenschappelijk onderzoek en specialistische kennis.
          </p>
        </div>
        <div class="glass-panel kinetic-hover p-8 rounded-2xl space-y-4 reveal">
          <span class="material-symbols-outlined text-primary text-5xl">handshake</span>
          <h3 class="font-headline-md text-headline-md text-on-surface">Integriteit</h3>
          <p class="font-body-md text-body-md text-on-surface-variant">
            Een veilige haven voor kinderen, ouders en professionals.
          </p>
        </div>
        <div class="glass-panel kinetic-hover p-8 rounded-2xl space-y-4 reveal">
          <span class="material-symbols-outlined text-primary text-5xl">trending_up</span>
          <h3 class="font-headline-md text-headline-md text-on-surface">Impact</h3>
          <p class="font-body-md text-body-md text-on-surface-variant">
            Wij streven naar concrete, betekenisvolle resultaten in elke situatie.
          </p>
        </div>
      </div>
    </div>
  </section>

  <script>
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) entry.target.classList.add('visible');
        });
      },
      { threshold: 0.1 }
    );
    document.querySelectorAll('.reveal').forEach((el) => observer.observe(el));
  </script>
</BaseLayout>
