---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import heroImg from '../assets/images/index-0611a9af.jpg';
import coachingImg from '../assets/images/index-45e895e1.jpg';
import strategieImg from '../assets/images/index-15a0dac8.jpg';
---

<BaseLayout
  title="Home"
  description="Specialistische begeleiding voor hoogbegaafde kinderen en strategische groei voor scholen en sportverenigingen. 100% maatwerk."
>
  <!-- Hero Section -->
  <section class="relative min-h-[90vh] flex items-center overflow-hidden pt-20">
    <div class="absolute inset-0 z-0">
      <Image
        src={heroImg}
        alt="Professionele begeleiding - kind krijgt de aandacht die het verdient"
        class="w-full h-full object-cover opacity-60"
        loading="eager"
        widths={[768, 1280, 1920]}
        sizes="100vw"
      />
      <div class="absolute inset-0 hero-gradient"></div>
    </div>
    <div
      class="relative z-10 w-full max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop"
    >
      <div class="max-w-3xl reveal">
        <span
          class="inline-flex items-center gap-2 px-3 py-1 mb-6 glass-panel rounded-full text-secondary-fixed-dim font-label-sm text-label-sm uppercase tracking-widest"
        >
          <span class="material-symbols-outlined text-[18px]">verified</span>
          Expertise in Hoogbegaafdheid
        </span>
        <h1
          class="font-display-lg text-display-lg-mobile md:text-display-lg text-on-surface mb-6 leading-tight"
        >
          Ontketen potentieel, <span class="text-primary italic">herstel balans.</span>
        </h1>
        <p class="font-body-lg text-body-lg text-on-surface-variant mb-10 max-w-xl">
          Elk kind verdient het om begrepen en gezien te worden. Wij helpen hoogbegaafde kinderen
          groeien — en geven ouders, scholen en sportverenigingen de tools om dit mogelijk te maken.
        </p>
        <div class="flex flex-col sm:flex-row gap-4">
          <a
            href="/voor-ouders"
            class="bg-primary text-on-primary px-8 py-4 rounded-lg font-label-md flex items-center justify-center gap-2 hover:scale-105 transition-transform"
          >
            Start Jouw Traject
            <span class="material-symbols-outlined">arrow_forward</span>
          </a>
          <a
            href="/over-ons"
            class="glass-panel text-on-surface px-8 py-4 rounded-lg font-label-md hover:bg-white/10 transition-colors text-center"
          >
            Bekijk Diensten
          </a>
        </div>
      </div>
    </div>
    <div
      class="absolute bottom-12 left-1/2 -translate-x-1/2 hidden md:flex flex-col items-center gap-2 opacity-50 text-on-surface"
    >
      <span class="font-label-sm text-label-sm">ONTDEK MEER</span>
      <span class="material-symbols-outlined animate-bounce">expand_more</span>
    </div>
  </section>

  <!-- Target Groups / Entry Points -->
  <section class="py-24 bg-surface relative">
    <div class="max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop">
      <div class="max-w-2xl mb-16 reveal">
        <h2
          class="font-headline-xl text-headline-lg-mobile md:text-headline-xl text-on-surface mb-4"
        >
          Maatwerk voor elke context
        </h2>
        <p class="font-body-lg text-body-lg text-on-surface-variant">
          We begrijpen dat de uitdagingen rondom hoogbegaafdheid en talentontwikkeling verschillen
          per omgeving. Kies uw vertrekpunt.
        </p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-gutter">
        {
          [
            {
              icon: 'family_restroom',
              title: 'Ouders',
              accent: 'Mental Peace',
              body: 'binnen het gezin. Wij bieden de inzichten en tools om uw kind weer met plezier te laten leren en leven.',
              cta: 'ONTDEK MEER',
              href: '/voor-ouders',
            },
            {
              icon: 'school',
              title: 'Scholen',
              accent: 'Controle',
              body: 'terug over passend onderwijs. Strategische ondersteuning voor leerkrachten en IB-ers.',
              cta: 'BEKIJK STRATEGIE',
              href: '/voor-scholen',
            },
            {
              icon: 'sports_score',
              title: 'Sportverenigingen',
              accent: 'Status',
              body: 'van uw jeugdopleiding. Innovatieve coachingtechnieken voor cognitief getalenteerde atleten.',
              cta: 'VOOR VERENIGINGEN',
              href: '/voor-sportverenigingen',
            },
          ].map((c) => (
            <div class="group relative glass-panel kinetic-hover p-8 rounded-2xl flex flex-col h-full reveal">
              <div class="mb-8 w-16 h-16 rounded-lg bg-primary/10 flex items-center justify-center text-primary group-hover:bg-primary group-hover:text-on-primary transition-colors duration-500">
                <span class="material-symbols-outlined text-[32px]">{c.icon}</span>
              </div>
              <h3 class="font-headline-md text-headline-md text-on-surface mb-4">{c.title}</h3>
              <p class="font-body-md text-body-md text-on-surface-variant mb-8 flex-grow">
                Creëer <span class="text-primary font-bold">{c.accent}</span> {c.body}
              </p>
              <div class="pt-6 border-t border-outline-variant/40 flex items-center justify-between">
                <span class="font-label-md text-label-md text-primary">{c.cta}</span>
                <span class="material-symbols-outlined text-primary group-hover:translate-x-2 transition-transform">
                  trending_flat
                </span>
              </div>
              <a aria-label={`Meer over ${c.title}`} class="absolute inset-0 z-10" href={c.href} />
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Why us — honest founder framing (no invented metrics) -->
  <section class="py-20 bg-surface-container-lowest overflow-hidden relative">
    <div class="absolute top-0 right-0 opacity-[0.06] pointer-events-none">
      <span class="material-symbols-outlined text-primary" style="font-size: 400px;">bolt</span>
    </div>
    <div class="max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop relative z-10">
      <div class="max-w-2xl mb-12 reveal">
        <span class="font-label-sm text-label-sm text-secondary-fixed-dim uppercase tracking-widest"
          >Jonge onderneming, volle focus</span
        >
        <h2
          class="font-headline-xl text-headline-lg-mobile md:text-headline-xl text-on-surface mt-4"
        >
          Geen holle beloftes. Wel echte aandacht.
        </h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-gutter">
        {
          [
            {
              icon: 'handshake',
              title: '100% Maatwerk',
              body: 'Geen standaardtrajecten. Elk plan wordt opgebouwd rond dit kind, dit gezin, deze organisatie.',
            },
            {
              icon: 'psychology',
              title: 'Specialistische expertise',
              body: 'Gedreven door diepgaande kennis van hoogbegaafdheid en de psychologie van leren.',
            },
            {
              icon: 'diversity_3',
              title: 'Persoonlijke aanpak',
              body: 'Als nieuwe onderneming werken we met korte lijnen en volledige toewijding aan wie we begeleiden.',
            },
          ].map((s) => (
            <div class="glass-panel p-8 rounded-2xl reveal">
              <span class="material-symbols-outlined text-primary text-4xl mb-4">{s.icon}</span>
              <h3 class="font-headline-md text-headline-md text-on-surface mb-3">{s.title}</h3>
              <p class="font-body-md text-body-md text-on-surface-variant">{s.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Content Split Section -->
  <section class="py-24 bg-surface">
    <div class="max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        <div class="lg:col-span-5 reveal">
          <h2
            class="font-headline-xl text-headline-lg-mobile md:text-headline-xl text-on-surface mb-6 leading-tight"
          >
            Expertise die verder gaat dan de standaard.
          </h2>
          <p class="font-body-lg text-body-lg text-on-surface-variant mb-8">
            Talent2Empower combineert diepgaande psychologische kennis met een frisse, persoonlijke
            aanpak in onderwijs en sport. Wij kijken niet alleen naar wat er aan de oppervlakte
            zichtbaar is, maar naar de drijfveren en de context van het talent.
          </p>
          <ul class="space-y-4 mb-10">
            {
              [
                'Wetenschappelijk onderbouwde methodieken',
                'Focus op duurzame gedragsverandering',
                'Holistische benadering van talent',
              ].map((item) => (
                <li class="flex items-center gap-3">
                  <span class="material-symbols-outlined text-primary">check_circle</span>
                  <span class="font-body-md text-body-md text-on-surface">{item}</span>
                </li>
              ))
            }
          </ul>
          <a
            href="/over-ons"
            class="text-primary font-label-md flex items-center gap-2 group w-fit"
          >
            Lees meer over onze visie
            <span class="material-symbols-outlined group-hover:translate-x-1 transition-transform"
              >arrow_right_alt</span
            >
          </a>
        </div>
        <div class="lg:col-span-7 grid grid-cols-2 gap-4">
          <div class="space-y-4">
            <div class="h-64 rounded-xl overflow-hidden ambient-shadow">
              <Image
                src={coachingImg}
                class="w-full h-full object-cover"
                alt="Expert begeleiding tijdens een coachingsessie"
              />
            </div>
            <div class="p-6 glass-panel rounded-xl">
              <h4 class="font-headline-md text-headline-md text-primary mb-2">Focus</h4>
              <p class="font-body-md text-body-md text-on-surface-variant">
                Wij brengen de focus terug op wat echt belangrijk is: het kind in zijn kracht
                zetten.
              </p>
            </div>
          </div>
          <div class="space-y-4 pt-12">
            <div class="p-6 bg-primary text-on-primary rounded-xl ambient-shadow">
              <span class="material-symbols-outlined text-4xl mb-4">psychology</span>
              <h4 class="font-headline-md text-headline-md mb-2">Inzicht</h4>
              <p class="font-body-md text-body-md text-on-primary/90">
                Begrip is de eerste stap naar verandering en groei.
              </p>
            </div>
            <div class="h-64 rounded-xl overflow-hidden ambient-shadow">
              <Image
                src={strategieImg}
                class="w-full h-full object-cover"
                alt="Strategische planning in samenwerking"
              />
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Call to Action -->
  <section class="py-24 bg-surface-container-lowest">
    <div class="max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop text-center">
      <div class="max-w-3xl mx-auto reveal">
        <h2
          class="font-headline-xl text-headline-lg-mobile md:text-headline-xl text-on-surface mb-8"
        >
          Klaar om de volgende stap te zetten?
        </h2>
        <p class="font-body-lg text-body-lg text-on-surface-variant mb-12">
          Of u nu een ouder bent die balans zoekt, een school die expertise nodig heeft of een
          vereniging die wil excelleren: wij staan voor u klaar.
        </p>
        <div
          class="inline-flex flex-col sm:flex-row gap-4 p-2 glass-panel rounded-2xl w-full sm:w-auto"
        >
          <a
            class="bg-primary text-on-primary px-10 py-5 rounded-xl font-label-md hover:scale-[1.02] transition-transform text-center"
            href="/contact">Plan een kennismaking</a
          >
          <a
            class="flex items-center justify-center gap-3 px-10 py-5 text-on-surface font-label-md hover:text-primary transition-colors"
            href="mailto:info@talent2empower.nl"
          >
            <span class="material-symbols-outlined">mail</span>
            Mail direct
          </a>
        </div>
      </div>
    </div>
  </section>

  <script>
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) entry.target.classList.add('visible');
        });
      },
      { threshold: 0.1 }
    );
    document.querySelectorAll('.reveal').forEach((el) => observer.observe(el));
  </script>
</BaseLayout>
