---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Contact - Talent2Empower"
  description="Neem contact op met Talent2Empower. Wij helpen je graag verder met vragen over ouders, scholen of sportverenigingen."
>
  <section class="pt-24 pb-16 md:pb-24 px-margin-mobile md:px-margin-desktop bg-surface-dim">
    <div class="max-w-container-max mx-auto">
      <div
        class="glass-panel rounded-3xl shadow-2xl overflow-hidden grid md:grid-cols-2 border border-outline-variant/40 reveal"
      >
        <!-- Contact Information -->
        <div class="p-8 md:p-12 bg-primary text-on-primary space-y-12">
          <div>
            <span
              class="inline-block mb-6 font-label-sm text-label-sm uppercase tracking-widest opacity-70"
              >Contact</span
            >
            <h1
              class="font-display-lg text-display-lg-mobile md:text-display-lg font-bold mb-6 leading-tight"
            >
              Zet de eerste stap
            </h1>
            <p class="font-body-lg text-body-lg opacity-90">
              Klaar voor meer rust, controle of groei? Laat ons weten hoe we kunnen helpen en we
              nemen binnen 24 uur contact met u op.
            </p>
          </div>

          <div class="space-y-8">
            <div class="flex items-center gap-6">
              <div
                class="w-14 h-14 rounded-2xl bg-white/10 flex items-center justify-center backdrop-blur-sm border border-white/20 shrink-0"
              >
                <span class="material-symbols-outlined text-3xl">mail</span>
              </div>
              <div>
                <p class="font-label-sm text-label-sm uppercase tracking-widest opacity-70 mb-1">
                  Email ons
                </p>
                <p class="font-body-lg text-body-lg font-bold">info@talent2empower.nl</p>
              </div>
            </div>

            <div class="flex items-center gap-6">
              <div
                class="w-14 h-14 rounded-2xl bg-white/10 flex items-center justify-center backdrop-blur-sm border border-white/20 shrink-0"
              >
                <span class="material-symbols-outlined text-3xl">location_on</span>
              </div>
              <div>
                <p class="font-label-sm text-label-sm uppercase tracking-widest opacity-70 mb-1">
                  Locatie
                </p>
                <p class="font-body-lg text-body-lg font-bold">Muiderweg 57, Zeewolde</p>
              </div>
            </div>
          </div>

          <div class="pt-8">
            <div class="w-full aspect-video rounded-2xl overflow-hidden border border-white/20">
              <iframe
                title="Locatie Talent2Empower — Muiderweg 57, Zeewolde"
                src="https://maps.google.com/maps?q=Muiderweg%2057%20Zeewolde&z=15&output=embed"
                class="w-full h-full"
                style="border: 0;"
                loading="lazy"
                referrerpolicy="no-referrer-when-downgrade"
                allowfullscreen></iframe>
            </div>
          </div>
        </div>

        <!-- Email CTA (no form/backend — direct contact only) -->
        <div class="p-8 md:p-12 glass-panel flex flex-col justify-center">
          <span
            class="font-label-sm text-label-sm uppercase tracking-widest text-secondary-fixed-dim mb-4"
            >Direct contact</span
          >
          <h2 class="font-headline-lg text-headline-lg text-on-surface mb-4">
            Stuur ons een bericht
          </h2>
          <p class="font-body-lg text-body-lg text-on-surface-variant mb-8">
            Vertel ons kort over uw situatie en waar u naar op zoek bent. We reageren doorgaans
            binnen 24 uur. Kies hieronder uw onderwerp — of mail ons rechtstreeks.
          </p>

          <div class="space-y-3 mb-8">
            {
              [
                {
                  label: 'Ouder — Rust voor mijn gezin',
                  subject: 'Aanvraag: Rust voor mijn gezin',
                },
                { label: 'School — Controle & CoFun', subject: 'Aanvraag: School & CoFun' },
                {
                  label: 'Sport — Professionalisering',
                  subject: 'Aanvraag: Professionalisering sportvereniging',
                },
                { label: 'Turn Fotografie', subject: 'Aanvraag: Turn Fotografie' },
              ].map((o) => (
                <a
                  href={`mailto:info@talent2empower.nl?subject=${encodeURIComponent(o.subject)}`}
                  class="flex items-center justify-between gap-4 px-5 py-4 rounded-xl border border-outline-variant/40 bg-surface-container/40 hover:border-primary hover:bg-primary/5 transition-colors group"
                >
                  <span class="font-body-md text-body-md text-on-surface">{o.label}</span>
                  <span class="material-symbols-outlined text-primary group-hover:translate-x-1 transition-transform">
                    arrow_forward
                  </span>
                </a>
              ))
            }
          </div>

          <div class="p-6 rounded-2xl bg-surface-container/40 border border-outline-variant/40">
            <p
              class="font-label-sm text-label-sm uppercase tracking-widest text-on-surface-variant mb-2"
            >
              Ons e-mailadres
            </p>
            <div class="flex flex-wrap items-center gap-3">
              <a
                href="mailto:info@talent2empower.nl"
                class="font-headline-md text-headline-md text-primary hover:underline break-all"
                >info@talent2empower.nl</a
              >
              <button
                data-copy="info@talent2empower.nl"
                class="inline-flex items-center gap-2 px-3 py-2 rounded-lg glass-panel text-on-surface font-label-sm text-label-sm hover:bg-primary/10 transition-colors shrink-0"
              >
                <span class="material-symbols-outlined text-[18px]" data-copy-icon
                  >content_copy</span
                >
                <span data-copy-label>Kopieer</span>
              </button>
            </div>
          </div>

          <div class="mt-8 flex items-center gap-6">
            <div class="flex items-center gap-2 text-on-surface-variant">
              <span class="material-symbols-outlined text-primary">handshake</span>
              <span class="font-label-sm text-[10px] uppercase tracking-tighter"
                >Persoonlijk contact</span
              >
            </div>
            <div class="flex items-center gap-2 text-on-surface-variant">
              <span class="material-symbols-outlined text-primary">schedule</span>
              <span class="font-label-sm text-[10px] uppercase tracking-tighter"
                >Reactie binnen 24u</span
              >
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <script>
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) entry.target.classList.add('visible');
        });
      },
      { threshold: 0.1 }
    );
    document.querySelectorAll('.reveal').forEach((el) => observer.observe(el));

    // Copy e-mail address to clipboard (robust fallback since desktops may have no mail client).
    document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const value = btn.dataset.copy ?? '';
        const icon = btn.querySelector('[data-copy-icon]');
        const label = btn.querySelector('[data-copy-label]');
        try {
          await navigator.clipboard.writeText(value);
        } catch {
          const ta = document.createElement('textarea');
          ta.value = value;
          document.body.appendChild(ta);
          ta.select();
          document.execCommand('copy');
          ta.remove();
        }
        if (icon) icon.textContent = 'check';
        if (label) label.textContent = 'Gekopieerd!';
        setTimeout(() => {
          if (icon) icon.textContent = 'content_copy';
          if (label) label.textContent = 'Kopieer';
        }, 2000);
      });
    });
  </script>
</BaseLayout>
