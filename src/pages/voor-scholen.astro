---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import klasImg from '../assets/images/voor-scholen-2cc6d77b.jpg';
import mentorImg from '../assets/images/voor-scholen-b9105f2d.jpg';
---

<BaseLayout
  title="Scholen - Krijg de regie terug"
  description="Structurele ondersteuning en cognitieve ontwikkeling voor scholen die streven naar maximale talentontplooiing zonder de grip op het klasproces te verloren."
>
  <!-- Hero Section -->
  <section class="relative min-h-[80vh] flex items-center overflow-hidden pt-20">
    <div class="absolute inset-0 z-0">
      <Image
        src={klasImg}
        alt="High performance classroom environment"
        class="w-full h-full object-cover opacity-90"
        loading="eager"
        widths={[768, 1280, 1920]}
        sizes="100vw"
      />
      <div
        class="absolute inset-0 bg-gradient-to-r from-surface-bright via-surface-bright/80 to-transparent"
      >
      </div>
    </div>
    <div class="relative z-10 w-full px-margin-desktop max-w-container-max mx-auto">
      <div class="max-w-2xl">
        <span
          class="inline-block font-label-sm text-label-sm bg-primary-container text-on-primary-container px-3 py-1 rounded mb-6"
          >VOOR ONDERWIJSPROFESSIONALS</span
        >
        <h1
          class="font-headline-lg text-headline-lg md:text-display-lg md:leading-[1.1] text-on-background mb-6"
        >
          Krijg de regie terug over de groei van <span class="text-primary italic"
            >hoogbegaafde</span
          > leerlingen.
        </h1>
        <p class="font-body-lg text-body-lg text-on-surface-variant mb-8 max-w-lg">
          Structurele ondersteuning en cognitieve ontwikkeling voor scholen die streven naar
          maximale talentontplooiing zonder de grip op het klasproces te verliezen.
        </p>
        <div class="flex flex-wrap gap-4">
          <button
            class="bg-secondary text-on-secondary px-8 py-4 rounded-lg font-body-md font-bold shadow-lg hover:shadow-xl transition-all"
          >
            Ontdek CoFun Programma
          </button>
          <button
            class="border-2 border-primary text-primary px-8 py-4 rounded-lg font-body-md font-bold hover:bg-primary/5 transition-all"
          >
            Maak een afspraak
          </button>
        </div>
      </div>
    </div>
  </section>
  <!-- Value Proposition / Bento Grid -->
  <section class="py-24 bg-surface px-margin-desktop">
    <div class="max-w-container-max mx-auto">
      <div class="flex flex-col md:flex-row justify-between items-end mb-12 gap-6">
        <div class="max-w-xl">
          <h2 class="font-headline-lg text-headline-lg text-on-background mb-4">
            Controle door Inzicht &amp; Structuur
          </h2>
          <p class="font-body-md text-body-md text-on-surface-variant">
            Wij bieden scholen de tools om meer- en hoogbegaafde leerlingen niet alleen te 'bezig te
            houden', maar ze daadwerkelijk te laten groeien middels wetenschappelijke kaders.
          </p>
        </div>
        <div class="font-label-md text-label-md text-primary flex items-center gap-2">
          <span class="material-symbols-outlined" style="font-variation-settings: 'FILL' 1;"
            >analytics</span
          >
          WETENSCHAPPELIJK ONDERBOUWD
        </div>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-12 gap-gutter">
        <!-- Feature 1: CoFun -->
        <div
          class="md:col-span-8 bg-surface-container-low p-10 rounded-xl bento-card border border-outline-variant flex flex-col justify-between"
        >
          <div>
            <div class="w-12 h-12 bg-primary flex items-center justify-center rounded-lg mb-6">
              <span class="material-symbols-outlined text-white">psychology</span>
            </div>
            <h3 class="font-headline-md text-headline-md mb-4 text-on-background">
              CoFun: Focus op Cognitieve Functies
            </h3>
            <p class="font-body-md text-body-md text-on-surface-variant max-w-lg">
              Ons paradepaardje. Een gestructureerd programma dat zich richt op de executieve en
              cognitieve functies die vaak onderontwikkeld blijven bij snelle denkers.
            </p>
          </div>
          <div
            class="mt-8 pt-8 border-t border-outline-variant/30 grid grid-cols-2 md:grid-cols-3 gap-6"
          >
            <div>
              <div class="font-label-md text-primary mb-1">STAP 01</div>
              <div class="font-body-md font-bold">Diagnostiek</div>
            </div>
            <div>
              <div class="font-label-md text-primary mb-1">STAP 02</div>
              <div class="font-body-md font-bold">Interventie</div>
            </div>
            <div>
              <div class="font-label-md text-primary mb-1">STAP 03</div>
              <div class="font-body-md font-bold">Monitoring</div>
            </div>
          </div>
        </div>
        <!-- Feature 2: Professionalization -->
        <div
          class="md:col-span-4 bg-on-background text-surface-bright p-10 rounded-xl bento-card flex flex-col justify-between"
        >
          <div>
            <div class="w-12 h-12 bg-secondary flex items-center justify-center rounded-lg mb-6">
              <span class="material-symbols-outlined text-white">school</span>
            </div>
            <h3 class="font-headline-md text-headline-md mb-4 leading-tight">
              Professionalisering van Leerkrachten
            </h3>
            <p class="font-body-md text-body-md text-surface-variant">
              Trainingen en workshops die direct toepasbaar zijn in de drukke dagelijkse praktijk.
            </p>
          </div>
          <ul class="space-y-3 mt-8">
            <li class="flex items-center gap-3 font-label-sm">
              <span class="material-symbols-outlined text-primary text-sm">check_circle</span>
              SIGNALEERVAARDIGHEDEN
            </li>
            <li class="flex items-center gap-3 font-label-sm">
              <span class="material-symbols-outlined text-primary text-sm">check_circle</span>
              COMPACTEN &amp; VERRIJKEN
            </li>
            <li class="flex items-center gap-3 font-label-sm">
              <span class="material-symbols-outlined text-primary text-sm">check_circle</span>
              FEEDBACK-MECHANISMEN
            </li>
          </ul>
        </div>
        <!-- Feature 3: Practical Tools -->
        <div
          class="md:col-span-4 bg-surface-container-high p-8 rounded-xl bento-card border border-outline-variant"
        >
          <span class="material-symbols-outlined text-primary mb-4" style="font-size: 32px;"
            >construction</span
          >
          <h4 class="font-headline-md text-headline-md mb-3">Praktische Tools</h4>
          <p class="font-body-md text-body-md text-on-surface-variant">
            Geen vage rapporten, maar tastbare materialen die morgen in de klas kunnen worden
            ingezet.
          </p>
        </div>
        <!-- Feature 4: Scientific Basis -->
        <div
          class="md:col-span-8 relative overflow-hidden bg-white p-8 rounded-xl bento-card border border-outline-variant flex items-center"
        >
          <div class="relative z-10 md:w-3/5">
            <h4 class="font-headline-md text-headline-md mb-3">Wetenschappelijk Fundament</h4>
            <p class="font-body-md text-body-md text-on-surface-variant">
              Onze methodiek rust op de pijlers van cognitieve psychologie en moderne
              neurobiologische inzichten over het hoogbegaafde brein.
            </p>
          </div>
          <div
            class="absolute right-0 top-0 h-full w-1/3 bg-primary/10 flex items-center justify-center"
          >
            <span
              class="material-symbols-outlined text-primary"
              style="font-size: 80px; opacity: 0.2;">science</span
            >
          </div>
        </div>
      </div>
    </div>
  </section>
  <!-- Content Section: The Program -->
  <section class="py-24 bg-on-background text-surface-bright relative overflow-hidden">
    <div
      class="absolute top-0 right-0 w-96 h-96 bg-primary/20 blur-[100px] rounded-full -mr-48 -mt-48"
    >
    </div>
    <div
      class="absolute bottom-0 left-0 w-96 h-96 bg-secondary/10 blur-[100px] rounded-full -ml-48 -mb-48"
    >
    </div>
    <div
      class="max-w-container-max mx-auto px-margin-desktop grid grid-cols-1 md:grid-cols-2 gap-20 items-center"
    >
      <div class="relative">
        <Image
          src={mentorImg}
          alt="Teacher mentoring a student"
          class="rounded-2xl shadow-2xl grayscale transition-all duration-700 hover:grayscale-0"
        />
        <div class="absolute -bottom-6 -right-6 bg-secondary p-8 rounded-xl hidden md:block">
          <div class="text-4xl font-bold mb-2">94%</div>
          <div class="text-xs font-label-sm uppercase tracking-wider opacity-80">
            Effectiviteit Score
          </div>
        </div>
      </div>
      <div>
        <h2 class="font-headline-lg text-headline-lg mb-8 leading-tight">
          Gestructureerde steun waar het telt.
        </h2>
        <div class="space-y-10">
          <div class="flex gap-6">
            <div
              class="flex-shrink-0 w-12 h-12 rounded-full border border-primary flex items-center justify-center font-label-md text-primary"
            >
              01
            </div>
            <div>
              <h5 class="font-headline-md text-headline-md text-body-lg mb-2">
                Analyse van de huidige aanpak
              </h5>
              <p class="text-surface-variant font-body-md">
                We kijken samen naar wat er al staat en waar de blinde vlekken zitten in de
                signalering en begeleiding.
              </p>
            </div>
          </div>
          <div class="flex gap-6">
            <div
              class="flex-shrink-0 w-12 h-12 rounded-full border border-primary flex items-center justify-center font-label-md text-primary"
            >
              02
            </div>
            <div>
              <h5 class="font-headline-md text-headline-md text-body-lg mb-2">
                Implementatie van CoFun
              </h5>
              <p class="text-surface-variant font-body-md">
                Onze specialisten begeleiden het team bij het inbedden van het programma in het
                dagelijkse rooster.
              </p>
            </div>
          </div>
          <div class="flex gap-6">
            <div
              class="flex-shrink-0 w-12 h-12 rounded-full border border-primary flex items-center justify-center font-label-md text-primary"
            >
              03
            </div>
            <div>
              <h5 class="font-headline-md text-headline-md text-body-lg mb-2">Duurzame Borging</h5>
              <p class="text-surface-variant font-body-md">
                Geen eenmalige training, maar doorlopende intervisie om de kwaliteit en de grip te
                garanderen.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
  <!-- CTA Section -->
  <section class="py-24 bg-surface px-margin-mobile md:px-margin-desktop">
    <div
      class="max-w-container-max mx-auto bg-primary text-white rounded-3xl p-12 md:p-20 relative overflow-hidden"
    >
      <div class="relative z-10 flex flex-col md:flex-row items-center justify-between gap-12">
        <div class="max-w-xl text-center md:text-left">
          <h2 class="font-headline-lg text-headline-lg mb-6">
            Klaar om de regie in de klas te herpakken?
          </h2>
          <p class="text-lg opacity-90 mb-0">
            Neem vandaag nog contact op voor een vrijblijvend adviesgesprek over de mogelijkheden
            voor uw school.
          </p>
        </div>
        <div class="flex flex-col gap-4 w-full md:w-auto">
          <a
            href="mailto:info@talent2empower.nl"
            class="bg-secondary text-white px-10 py-5 rounded-xl font-bold hover:scale-105 transition-transform text-center"
          >
            Vraag Brochure Aan
          </a>
          <a
            href="/contact"
            class="bg-white/10 backdrop-blur-sm border border-white/20 px-10 py-5 rounded-xl font-bold hover:bg-white/20 transition-all text-center"
          >
            Praat met een Expert
          </a>
        </div>
      </div>
      <!-- Abstract graphic element -->
      <div
        class="absolute -right-20 -bottom-20 w-80 h-80 bg-primary-container rounded-full opacity-20 blur-3xl"
      >
      </div>
    </div>
  </section>

  <script>
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('opacity-100', 'translate-y-0');
            entry.target.classList.remove('opacity-0', 'translate-y-8');
          }
        });
      },
      { threshold: 0.1 }
    );

    document.querySelectorAll('.bento-card').forEach((card) => {
      card.classList.add('transition-all', 'duration-700', 'opacity-0', 'translate-y-8');
      observer.observe(card);
    });
  </script>
</BaseLayout>
