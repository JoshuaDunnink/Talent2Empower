---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import thuisImg from '../assets/images/voor-ouders-04573a66.jpg';
import groepImg from '../assets/images/voor-ouders-fd6aec46.jpg';
---

<BaseLayout
  title="Ouders - Mentale Rust"
  description="Begrijpen wat er echt speelt bij onderpresteren of terugtrekking is de eerste stap naar verbinding. Wij begeleiden hoogbegaafde en sensitieve kinderen om hun talent weer met plezier in te zetten."
>
  <!-- Hero Section -->
  <header class="relative min-h-[85vh] flex items-center pt-24 pb-16 overflow-hidden bg-surface">
    <div class="absolute inset-0 z-0 opacity-30 pointer-events-none">
      <div
        class="absolute top-0 right-0 w-[600px] h-[600px] bg-primary rounded-full blur-[120px] -translate-y-1/2 translate-x-1/2"
      >
      </div>
      <div
        class="absolute bottom-0 left-0 w-[400px] h-[400px] bg-secondary-fixed rounded-full blur-[100px] translate-y-1/3 -translate-x-1/3"
      >
      </div>
    </div>
    <div
      class="container mx-auto px-margin-mobile md:px-margin-desktop max-w-container-max relative z-10"
    >
      <div class="grid lg:grid-cols-2 gap-12 items-center">
        <div class="space-y-8 max-w-2xl reveal">
          <span
            class="inline-block font-label-sm text-label-sm uppercase tracking-widest text-secondary-fixed-dim"
            >Mentale Rust</span
          >
          <h1
            class="font-display-lg text-display-lg-mobile md:text-display-lg text-on-surface leading-tight"
          >
            Weer rust in huis, omdat uw kind eindelijk wordt <span class="text-primary italic"
              >gezien</span
            >.
          </h1>
          <p class="font-body-lg text-body-lg text-on-surface-variant">
            Begrijpen wat er echt speelt bij onderpresteren of terugtrekking is de eerste stap naar
            verbinding. Wij begeleiden hoogbegaafde en sensitieve kinderen om hun talent weer met
            plezier in te zetten — zodat het thuis weer fijn wordt.
          </p>
          <div class="flex flex-wrap gap-4 pt-4">
            <a
              href="mailto:info@talent2empower.nl"
              class="bg-primary text-on-primary px-8 py-4 rounded-lg font-label-md hover:scale-105 transition-transform"
              >Direct Hulp Vragen</a
            >
            <a
              href="#aanpak"
              class="glass-panel text-on-surface px-8 py-4 rounded-lg font-label-md hover:bg-white/10 transition-colors"
              >Ontdek onze aanpak</a
            >
          </div>

          <!-- Honest founder framing (no invented metrics) -->
          <div class="flex items-center gap-3 pt-4">
            <span class="material-symbols-outlined text-secondary-fixed-dim">bolt</span>
            <p class="font-body-md text-body-md text-on-surface-variant">
              <span class="font-bold text-on-surface">Een frisse, specialistische aanpak</span> — 100%
              maatwerk voor elk gezin.
            </p>
          </div>
        </div>

        <div class="relative rounded-[2rem] overflow-hidden ambient-shadow group reveal">
          <Image
            src={thuisImg}
            alt="Warm thuissituatie met ouder en kind die samen leren"
            class="w-full aspect-[4/5] object-cover transition-transform duration-700 group-hover:scale-105"
            loading="eager"
          />
          <div class="absolute bottom-6 left-6 right-6 p-6 glass-panel rounded-2xl">
            <div class="flex items-center gap-4">
              <div
                class="w-12 h-12 rounded-full bg-primary flex items-center justify-center text-on-primary flex-shrink-0"
              >
                <span class="material-symbols-outlined">favorite</span>
              </div>
              <div>
                <p class="font-bold text-on-surface">Persoonlijke aandacht</p>
                <p class="text-on-surface-variant text-sm">
                  Korte lijnen en volledige toewijding aan uw kind.
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </header>

  <!-- Bento Grid Content -->
  <section class="py-16 md:py-24 bg-surface-container-lowest" id="aanpak">
    <div class="container mx-auto px-margin-mobile md:px-margin-desktop max-w-container-max">
      <div class="mb-16 text-center max-w-3xl mx-auto reveal">
        <h2
          class="font-headline-xl text-headline-lg-mobile md:text-headline-xl text-on-surface mb-6"
        >
          De signalen begrijpen
        </h2>
        <p class="font-body-lg text-body-lg text-on-surface-variant">
          Wanneer een kind vastloopt, uit zich dat vaak in gedrag dat we niet direct begrijpen. Wij
          kijken voorbij de buitenkant naar de bron van de blokkade — altijd met het welzijn van uw
          kind als vertrekpunt.
        </p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <!-- Large Card: Peergroepen -->
        <div
          class="md:col-span-2 glass-panel kinetic-hover p-10 rounded-2xl border border-outline-variant/40 flex flex-col justify-between reveal"
        >
          <div>
            <div
              class="w-16 h-16 bg-primary/10 rounded-2xl flex items-center justify-center text-primary mb-8"
            >
              <span class="material-symbols-outlined text-4xl">groups</span>
            </div>
            <h3 class="font-headline-md text-headline-md text-primary mb-4">
              Peergroepen: Herkenning &amp; Groei
            </h3>
            <p class="font-body-md text-body-md text-on-surface-variant max-w-xl mb-6">
              Soms is de grootste stap naar rust de wetenschap dat je niet alleen bent. In onze
              peergroepen ontmoeten kinderen ontwikkelingsgelijken. Hier hoeven ze zich niet aan te
              passen, maar mogen ze ontdekken wie ze zijn.
            </p>
            <ul class="space-y-4 mb-8">
              <li class="flex items-center gap-3 text-on-surface-variant">
                <span class="material-symbols-outlined text-primary">check_circle</span>
                Sociale vaardigheden oefenen in een veilige omgeving
              </li>
              <li class="flex items-center gap-3 text-on-surface-variant">
                <span class="material-symbols-outlined text-primary">check_circle</span>
                Versterken van de eigen identiteit
              </li>
            </ul>
          </div>
          <Image
            src={groepImg}
            class="w-full h-64 object-cover rounded-xl mt-4"
            alt="Kinderen in een groepsactiviteit in een moderne ruimte"
          />
        </div>
        <!-- Small Card: Individual Coaching -->
        <div
          class="glass-panel kinetic-hover p-10 rounded-2xl border border-outline-variant/40 flex flex-col reveal"
        >
          <div
            class="w-16 h-16 bg-primary/10 rounded-2xl flex items-center justify-center text-primary mb-8"
          >
            <span class="material-symbols-outlined text-4xl">person_search</span>
          </div>
          <h3 class="font-headline-md text-headline-md text-on-surface mb-4">
            Individuele Coaching
          </h3>
          <p class="font-body-md text-body-md text-on-surface-variant mb-auto">
            Maatwerk begeleiding gericht op de specifieke behoeften van uw kind. We werken aan
            executieve functies, faalangst of motivatie.
          </p>
          <div class="pt-8">
            <a
              class="inline-flex items-center gap-2 text-primary font-label-md group"
              href="mailto:info@talent2empower.nl"
            >
              Lees meer over coaching
              <span class="material-symbols-outlined transition-transform group-hover:translate-x-1"
                >arrow_forward</span
              >
            </a>
          </div>
        </div>
        <!-- Info Card: Underperformance -->
        <div
          class="glass-panel kinetic-hover p-8 rounded-2xl border border-outline-variant/40 reveal"
        >
          <span
            class="font-label-sm text-label-sm text-secondary-fixed-dim uppercase tracking-widest block mb-4"
            >Focuspunt</span
          >
          <h4 class="font-headline-md text-headline-md text-on-surface mb-4">Onderpresteren</h4>
          <p class="font-body-md text-body-md text-on-surface-variant">
            Is het luiheid of onvermogen? Vaak schuilt er een gebrek aan uitdaging of angst om te
            falen achter de daling in prestaties.
          </p>
        </div>
        <!-- Info Card: Withdrawal -->
        <div class="bg-primary text-on-primary p-8 rounded-2xl kinetic-hover reveal">
          <span
            class="font-label-sm text-label-sm uppercase tracking-widest block mb-4 text-on-primary/70"
            >Focuspunt</span
          >
          <h4 class="font-headline-md text-headline-md mb-4">Terugtrekking</h4>
          <p class="font-body-md text-body-md text-on-primary/90">
            Wanneer de buitenwereld te luid wordt, trekt een sensitief kind zich terug. Wij bouwen
            een brug terug naar de verbinding.
          </p>
        </div>
        <!-- Value Card: Maatwerk (honest, no invented metrics) -->
        <div
          class="glass-panel kinetic-hover p-8 rounded-2xl border border-outline-variant/40 flex flex-col justify-center items-center text-center reveal"
        >
          <span class="material-symbols-outlined text-primary text-5xl mb-3">handshake</span>
          <p class="font-headline-md text-headline-md text-primary mb-2">100% Maatwerk</p>
          <p class="font-label-md text-label-md text-on-surface-variant uppercase tracking-widest">
            Elk plan rond dít kind, dít gezin
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Value Statement Section (replaces fake testimonial) -->
  <section class="py-16 md:py-24 bg-surface overflow-hidden">
    <div
      class="container mx-auto px-margin-mobile md:px-margin-desktop max-w-container-max relative"
    >
      <div class="max-w-4xl mx-auto text-center reveal">
        <span
          class="font-label-sm text-label-sm uppercase tracking-widest text-secondary-fixed-dim block mb-6"
          >Onze belofte</span
        >
        <blockquote
          class="font-headline-xl text-headline-lg-mobile md:text-headline-xl text-on-surface mb-10 leading-snug"
        >
          Geen holle beloftes of standaardtrajecten. Wel echte aandacht, korte lijnen en de rust die
          ontstaat wanneer een kind zich eindelijk begrepen voelt.
        </blockquote>
        <div class="flex items-center justify-center gap-4">
          <div
            class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center text-primary flex-shrink-0"
          >
            <span class="material-symbols-outlined">diversity_3</span>
          </div>
          <div class="text-left">
            <p class="font-bold text-on-surface">Jonge onderneming, volle focus</p>
            <p class="font-label-md text-sm text-on-surface-variant">Talent2Empower</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="py-16 md:py-24 bg-surface-container-lowest">
    <div class="container mx-auto px-margin-mobile md:px-margin-desktop max-w-container-max">
      <div class="glass-panel p-12 md:p-20 rounded-3xl text-center relative overflow-hidden reveal">
        <div
          class="absolute top-0 right-0 w-64 h-64 bg-primary/10 rounded-full blur-3xl -translate-y-1/2 translate-x-1/2 pointer-events-none"
        >
        </div>
        <div class="relative z-10 max-w-2xl mx-auto space-y-8">
          <h2
            class="font-headline-xl text-headline-lg-mobile md:text-headline-xl text-on-surface leading-tight"
          >
            Begin vandaag nog aan de weg naar rust.
          </h2>
          <p class="font-body-lg text-body-lg text-on-surface-variant">
            Heeft u het gevoel dat uw kind meer in zijn mars heeft, maar weet u niet hoe u dit naar
            boven haalt? Plan een vrijblijvend kennismakingsgesprek. Geen verplichtingen — wel een
            eerste stap naar balans.
          </p>
          <div class="flex flex-col sm:flex-row gap-4 justify-center">
            <a
              href="mailto:info@talent2empower.nl"
              class="bg-primary text-on-primary px-8 py-4 rounded-lg font-label-md hover:scale-105 transition-transform"
              >Plan Kennismaking</a
            >
            <a
              href="/contact"
              class="glass-panel text-on-surface px-8 py-4 rounded-lg font-label-md hover:bg-white/10 transition-colors"
              >Neem contact op</a
            >
          </div>
        </div>
      </div>
    </div>
  </section>

  <script>
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) entry.target.classList.add('visible');
        });
      },
      { threshold: 0.1 }
    );
    document.querySelectorAll('.reveal').forEach((el) => observer.observe(el));
  </script>
</BaseLayout>
