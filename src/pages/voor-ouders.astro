---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Ouders - Mentale Rust" description="Begrijpen wat er echt speelt bij onderpresteren of terugtrekking is de eerste stap naar verbinding. Wij begeleiden hoogbegaafde en sensitieve kinderen om hun talent weer met plezier in te zetten.">

<!-- Hero Section -->
<header class="relative min-h-[85vh] flex items-center pt-24 pb-16 overflow-hidden bg-surface-container-low">
  <div class="absolute inset-0 z-0 opacity-30 pointer-events-none">
    <div class="absolute top-0 right-0 w-[600px] h-[600px] bg-primary-container rounded-full blur-[120px] -translate-y-1/2 translate-x-1/2"></div>
    <div class="absolute bottom-0 left-0 w-[400px] h-[400px] bg-secondary-fixed rounded-full blur-[100px] translate-y-1/3 -translate-x-1/3"></div>
  </div>
  <div class="container mx-auto px-margin-mobile md:px-margin-desktop max-w-container-max relative z-10">
    <div class="grid lg:grid-cols-2 gap-12 items-center">
      <div class="space-y-8 max-w-2xl">
        <span class="inline-block px-4 py-1 rounded-full bg-primary-container text-on-primary-container font-label-md text-label-md tracking-wider">MENTALE RUST</span>
        <h1 class="font-headline-lg text-headline-lg-mobile md:text-headline-lg text-on-background leading-tight">
          Weer rust in huis, omdat uw kind eindelijk wordt <em>gezien</em>.
        </h1>
        <p class="font-body-lg text-body-lg text-on-surface-variant">
          Begrijpen wat er echt speelt bij onderpresteren of terugtrekking is de eerste stap naar verbinding. Wij begeleiden hoogbegaafde en sensitieve kinderen om hun talent weer met plezier in te zetten — zodat het thuis weer fijn wordt.
        </p>
        <div class="flex flex-wrap gap-4 pt-4">
          <a href="mailto:info@talent2empower.nl" class="bg-secondary text-on-secondary px-8 py-4 rounded-xl font-bold text-lg hover:opacity-90 shadow-lg shadow-secondary/20 transition-all">Direct Hulp Vragen</a>
          <button class="border-2 border-primary text-primary px-8 py-4 rounded-xl font-bold text-lg hover:bg-primary/5 transition-all">Ontdek onze aanpak</button>
        </div>

        <!-- Trust signal under the buttons -->
        <div class="flex items-center gap-4 pt-4">
          <div class="flex -space-x-2">
            <div class="w-8 h-8 rounded-full bg-primary-container flex items-center justify-center text-on-primary-container text-xs font-bold border-2 border-white">M</div>
            <div class="w-8 h-8 rounded-full bg-secondary-container flex items-center justify-center text-white text-xs font-bold border-2 border-white">J</div>
            <div class="w-8 h-8 rounded-full bg-primary flex items-center justify-center text-white text-xs font-bold border-2 border-white">S</div>
          </div>
          <p class="font-body-md text-body-md text-on-surface-variant"><span class="font-bold text-on-background">500+ gezinnen</span> gingen u voor</p>
        </div>
      </div>

      <div class="relative rounded-[2rem] overflow-hidden shadow-2xl group">
        <img alt="Warm thuissituatie met ouder en kind die samen leren" class="w-full aspect-[4/5] object-cover transition-transform duration-700 group-hover:scale-105" src="https://lh3.googleusercontent.com/aida-public/AB6AXuDcW_xBgfhC_KY-c7LYn0Ic7e3SfSVFEb_oMmdGCCayH-ljk5ZZzQXdo6SIFFiD6mbHTROnYaDizUY8eqx6lSw1oAmUYvIuqCKCgSJ8oQpfKMddWI8sHuwiFuzRozs9ig4IEyvUfiQs8taQReENTh4dbXB-Iox8w9jzgam_f8aG0_XbTKnDOZ4iApav5AI6o0yvM-E3nwmK9fKoiM47YgRv2TfCACJOtoODfxlyFsOLB4foxaJ4OwjsC6lC_DphYmMe0XaqXFLGpw8"/>
        <div class="absolute bottom-6 left-6 right-6 p-6 bg-white/90 backdrop-blur-md rounded-2xl shadow-lg">
          <div class="flex items-center gap-4">
            <div class="w-12 h-12 rounded-full bg-primary flex items-center justify-center text-white flex-shrink-0">
              <span class="material-symbols-outlined">verified</span>
            </div>
            <div>
              <p class="font-bold text-on-surface">94% van de ouders</p>
              <p class="text-on-surface-variant text-sm">ervaart meer harmonie in huis na 3 maanden.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</header>

<!-- Bento Grid Content -->
<section class="py-24 bg-white">
  <div class="container mx-auto px-margin-mobile md:px-margin-desktop max-w-container-max">
    <div class="mb-16 text-center max-w-3xl mx-auto">
      <h2 class="font-headline-lg text-headline-lg-mobile md:text-headline-lg text-on-background mb-6">De signalen begrijpen</h2>
      <p class="font-body-lg text-body-lg text-on-surface-variant">
        Wanneer een kind vastloopt, uit zich dat vaak in gedrag dat we niet direct begrijpen. Wij kijken voorbij de buitenkant naar de bron van de blokkade — altijd met het welzijn van uw kind als vertrekpunt.
      </p>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <!-- Large Card: Peergroepen -->
      <div class="md:col-span-2 bento-card bg-surface-container-low p-10 rounded-[2rem] border border-outline-variant flex flex-col justify-between">
        <div>
          <div class="w-16 h-16 bg-primary/10 rounded-2xl flex items-center justify-center text-primary mb-8">
            <span class="material-symbols-outlined text-4xl">groups</span>
          </div>
          <h3 class="font-headline-md text-headline-md text-primary mb-4">Peergroepen: Herkenning &amp; Groei</h3>
          <p class="font-body-md text-body-md text-on-surface-variant max-w-xl mb-6">
            Soms is de grootste stap naar rust de wetenschap dat je niet alleen bent. In onze peergroepen ontmoeten kinderen ontwikkelingsgelijken. Hier hoeven ze zich niet aan te passen, maar mogen ze ontdekken wie ze zijn.
          </p>
          <ul class="space-y-4 mb-8">
            <li class="flex items-center gap-3 text-on-surface-variant">
              <span class="material-symbols-outlined text-primary">check_circle</span>
              Sociale vaardigheden oefenen in een veilige omgeving
            </li>
            <li class="flex items-center gap-3 text-on-surface-variant">
              <span class="material-symbols-outlined text-primary">check_circle</span>
              Versterken van de eigen identiteit
            </li>
          </ul>
        </div>
        <img class="w-full h-64 object-cover rounded-xl mt-4" alt="Kinderen in een groepsactiviteit in een moderne ruimte" src="https://lh3.googleusercontent.com/aida-public/AB6AXuC0J9Gnjyjs32g7UXBNXXXY3z93qiBVUrYQ0R6BCgwQgtkGoyyaJCwgp2MISoRgWzcq7QUADwsXB6Lp725R94GbQopVwxqH6yOpAhJp7fR2vDfw1iBwKsHotHKKwNeNMsUP4dZXyZ-ixgJTYP6fEz9NAsi4ohv3SeK7BZFIHhY6L5uzmnYftXLKsMVpcDTHg9AAZV2lvGTxtGlEHuHIxbHKYXrYA8A_yWQf9F2x0XjrgDIN3RhbgyDn294XgGmFpgfS2qEBDwuQc0A"/>
      </div>
      <!-- Small Card: Individual Coaching -->
      <div class="bento-card bg-on-background text-white p-10 rounded-[2rem] flex flex-col">
        <div class="w-16 h-16 bg-primary-container rounded-2xl flex items-center justify-center text-on-primary-container mb-8">
          <span class="material-symbols-outlined text-4xl">person_search</span>
        </div>
        <h3 class="font-headline-md text-headline-md mb-4">Individuele Coaching</h3>
        <p class="font-body-md text-body-md text-surface-variant mb-auto">
          Maatwerk begeleiding gericht op de specifieke behoeften van uw kind. We werken aan executieve functies, faalangst of motivatie.
        </p>
        <div class="pt-8">
          <a class="inline-flex items-center gap-2 text-primary-container font-bold group" href="#">
            Lees meer over coaching
            <span class="material-symbols-outlined transition-transform group-hover:translate-x-1">arrow_forward</span>
          </a>
        </div>
      </div>
      <!-- Info Card: Underperformance -->
      <div class="bento-card bg-surface-container-high p-8 rounded-[2rem] border border-outline-variant">
        <span class="font-label-sm text-label-sm text-secondary uppercase tracking-widest block mb-4">FOCUSPUNT</span>
        <h4 class="font-headline-md text-headline-md text-on-background mb-4">Onderpresteren</h4>
        <p class="font-body-md text-body-md text-on-surface-variant">
          Is het luiheid of onvermogen? Vaak schuilt er een gebrek aan uitdaging of angst om te falen achter de daling in prestaties.
        </p>
      </div>
      <!-- Info Card: Withdrawal -->
      <div class="bento-card bg-primary text-white p-8 rounded-[2rem]">
        <span class="font-label-sm text-label-sm text-primary-container uppercase tracking-widest block mb-4">FOCUSPUNT</span>
        <h4 class="font-headline-md text-headline-md mb-4">Terugtrekking</h4>
        <p class="font-body-md text-body-md text-surface-bright/80">
          Wanneer de buitenwereld te luid wordt, trekt een sensitief kind zich terug. Wij bouwen een brug terug naar de verbinding.
        </p>
      </div>
      <!-- Info Card: Results -->
      <div class="bento-card bg-white p-8 rounded-[2rem] border-2 border-primary/20 flex flex-col justify-center items-center text-center">
        <p class="font-display-lg text-headline-lg text-primary mb-2">90+</p>
        <p class="font-label-md text-label-md text-on-surface-variant">TEVREDEN GEZINNEN PER JAAR</p>
      </div>
    </div>
  </div>
</section>

<!-- Testimonial Section -->
<section class="py-24 bg-surface-container-low overflow-hidden">
  <div class="container mx-auto px-margin-mobile md:px-margin-desktop max-w-container-max relative">
    <div class="absolute -top-12 -left-12 opacity-5 leading-none select-none" style="font-size: 12rem; font-family: Epilogue, sans-serif; font-weight: 800;">"</div>
    <div class="max-w-4xl mx-auto text-center">
      <blockquote class="font-headline-lg text-headline-lg-mobile md:text-headline-lg text-on-background mb-10 italic leading-snug">
        "Voor het eerst in jaren hebben we het gevoel dat onze zoon écht begrepen wordt. De rust in huis is teruggekeerd, en hij gaat weer met een glimlach naar school."
      </blockquote>
      <div class="flex items-center justify-center gap-4">
        <img class="w-16 h-16 rounded-full object-cover grayscale hover:grayscale-0 transition-all duration-500" alt="Tevreden ouder" src="https://lh3.googleusercontent.com/aida-public/AB6AXuCesU3Dj_7sflzAdxXqctW0LyYK_YLw8Q00P7c3tJUfZNpd5nRMW3De9osN3KYaiyRqGKF841QaZ2I5uHojyufXeAUZXafjTY-LV8AeJ3jfXXx4SJ2cskP3QiM9tkm1SE_DDEn8eal8Bk9kueHK7mJTsd-1TEXXHcrWKFfJWm2udGHsn2Q4wI8QOjxBY_Kew4JCaHNLIzE_dSFVLk_F4soGY1VtehbzHO-VwIF8P5A8A8nTCIFGJrwrXHlspUsBVKUfsx2qtxzalfA"/>
        <div class="text-left">
          <p class="font-bold text-on-background">Marije de V.</p>
          <p class="font-label-md text-sm text-on-surface-variant">Moeder van Jasper (11)</p>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- CTA Section -->
<section class="py-24">
  <div class="container mx-auto px-margin-mobile md:px-margin-desktop max-w-container-max">
    <div class="bg-secondary p-12 md:p-20 rounded-[3rem] text-center text-on-secondary relative overflow-hidden">
      <div class="absolute top-0 right-0 w-64 h-64 bg-white/10 rounded-full blur-3xl -translate-y-1/2 translate-x-1/2"></div>
      <div class="relative z-10 max-w-2xl mx-auto space-y-8">
        <h2 class="font-headline-lg text-headline-lg-mobile md:text-headline-lg leading-tight">Begin vandaag nog aan de weg naar rust.</h2>
        <p class="font-body-lg text-body-lg opacity-90">
          Heeft u het gevoel dat uw kind meer in zijn mars heeft, maar weet u niet hoe u dit naar boven haalt? Plan een vrijblijvend kennismakingsgesprek. Geen verplichtingen — wel een eerste stap naar balans.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="mailto:info@talent2empower.nl" class="bg-white text-secondary px-10 py-4 rounded-xl font-bold text-lg hover:bg-surface-bright transition-all">Plan Kennismaking</a>
          <a href="/contact" class="border-2 border-white text-white px-10 py-4 rounded-xl font-bold text-lg hover:bg-white/10 transition-all">Download Brochure</a>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('opacity-100', 'translate-y-0');
        entry.target.classList.remove('opacity-0', 'translate-y-8');
      }
    });
  }, { threshold: 0.1 });

  document.querySelectorAll('.bento-card').forEach(card => {
    card.classList.add('transition-all', 'duration-700', 'opacity-0', 'translate-y-8');
    observer.observe(card);
  });
</script>

</BaseLayout>
